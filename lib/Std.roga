module Std { always, id, not, match, or, and, range }

let always x =
  _ -> x


let id x =
  x


let not true =
  false
let not false =
  true


let match val fn =
  fn val


let or true _ = true
let or _ true = true
let or _ _ = false


let and true true = true
let and _ _ = false


let range limit =
    reverse (range_ [] 0 limit)

let range start limit =
    reverse (range_ [] start limit)

let range_ acc current limit =
    if (current >= limit) then
      acc
    else
      (range_ [current :: acc] (current + 1) limit)
